{
  "name": "chess-com-against-ai-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-engine.mjs && node scripts/prepare-maia.mjs",
    "prebuild": "node scripts/copy-engine.mjs && node scripts/prepare-maia.mjs",
    "prebuild:pages": "node scripts/copy-engine.mjs && node scripts/prepare-maia.mjs",
    "postinstall": "node scripts/copy-engine.mjs",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "tsx --test tests/session.test.js tests/review.test.ts",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "onnxruntime-web": "^1.24.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "6.4.3"
  }
}
